# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── JobStreet ──────────────────────────────────────────────────────────────────
JOBSTREET_EMAIL=your@email.com
JOBSTREET_PASSWORD=yourpassword

# ── LinkedIn ───────────────────────────────────────────────────────────────────
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# ── Indeed Singapore ───────────────────────────────────────────────────────────
# Indeed.sg works without login; leave blank to scrape as guest
INDEED_EMAIL=
INDEED_PASSWORD=

# ── Telegram (for phone notifications) ────────────────────────────────────────
# Step 1: Open Telegram → search @BotFather → /newbot → copy the token it gives you
# Step 2: Send /start to your new bot
# Step 3: Visit https://api.telegram.org/bot<TOKEN>/getUpdates → copy "id" from "chat"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Scraper behaviour ──────────────────────────────────────────────────────────
# Number of pages to scrape per platform (each page ≈ 10-30 jobs)
SCRAPE_PAGES=5
# Minimum Claude match score (0-100) to include in the report
MIN_SCORE=60
# Run browser in headless mode (true/false)
HEADLESS=true
